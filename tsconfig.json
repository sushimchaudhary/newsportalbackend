{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",

        "lib": ["ES2016"],
        "esModuleInterop": true,
        "moduleResolution": "node",
        
        "allowJs": true,
        "pretty" : true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,

        "types": ["node"],
        "target": "ES2016",
        "module": "CommonJS",
        "strict": true,
        "isolatedModules": true,      
        "skipLibCheck": true,
        "sourceMap": true,
       
        
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}